# Copy to .env and fill in real values. Never commit .env.
#
# Every value below has a working default — the app runs with this file
# copied verbatim. The only thing worth setting is OPENROUTER_API_KEY,
# which turns on AI auto-tagging; without it, new bookmarks just get no tags.

# --- AI auto-tagging (optional) ---
# Get a key at https://openrouter.ai/keys. Leave blank to disable tagging.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
LLM_TIMEOUT_SECONDS=15.0

# --- Semantic search (local, no API key, no cost) ---
# Model is downloaded once on first run and cached under EMBEDDING_CACHE_DIR.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.cache/fastembed
SEMANTIC_SCORE_THRESHOLD=0.55
SEMANTIC_SEARCH_LIMIT=12

# --- Storage ---
DB_PATH=data/bookmarks.db
FAVICON_DIR=data/favicons

# --- Deletes (optional) ---
# If set, DELETE requests must send this value in an X-Delete-Password header.
DELETE_PASSWORD=

# --- Admin: bulk link checker (optional) ---
# Gates /api/admin/* (the "check all links" sweep). Falls back to
# DELETE_PASSWORD when blank, so a single password covers both.
ADMIN_PASSWORD=
# A link is called "broken" only after this many consecutive failing sweeps;
# bot walls / rate limits / transient 5xx are always "uncertain", never broken.
LINK_CHECK_CONCURRENCY=10
LINK_CHECK_TIMEOUT_SECONDS=10.0
LINK_CHECK_BROKEN_THRESHOLD=1
LINK_CHECK_STALE_AFTER_SECONDS=1800

# --- Serving ---
# Only set ROOT_PATH if you serve the app under a URL subpath (e.g. /bookmark/)
# behind a reverse proxy that strips the prefix. Blank = served at the root.
ROOT_PATH=
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Production only ---
# If you run under a hardened systemd unit that makes $HOME read-only, point
# huggingface_hub's scratch dir back inside the app dir. Not needed for local
# dev or Docker. Use an absolute path.
# HF_HOME=/var/www/bookmark/.cache/huggingface
