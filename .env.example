# Copy to .env and fill in real values. Never commit .env.
ROOT_PATH=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
LLM_TIMEOUT_SECONDS=15.0
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.cache/fastembed
# huggingface_hub/xet scratch space — must stay inside the app dir because
# the systemd sandbox makes $HOME read-only.
HF_HOME=/var/www/bookmark/.cache/huggingface
SEMANTIC_SCORE_THRESHOLD=0.55
SEMANTIC_SEARCH_LIMIT=12
DELETE_PASSWORD=
DB_PATH=data/bookmarks.db
FAVICON_DIR=data/favicons
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_WINDOW_SECONDS=60
